
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  head      String
  total     Int      @default(0)
  submitted Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
